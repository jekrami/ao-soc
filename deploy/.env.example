# AI-SOC deployment settings (E4, M15).
# Copyright (c) 2026 Ekrami-Labs. All rights reserved.
#
# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay so:
# it holds the key that can approve a containment.
#
#   cp deploy/.env.example deploy/.env
#
# The defaults below are STAGE 0 of docs/PILOT-RUNBOOK.md: no model, no feed,
# nothing dispatched. Move to the next stage by changing the lines the runbook
# names for that stage, one stage at a time.
#
# The broker receives this whole file. Every name here is a name the code reads;
# a test fails the build if one is not (check_deployment_drift).

# --- Identity and access (A1 + human AAA) ---------------------------------
# Machine / connector keys for the broker (SIEM ingest, UI API service key,
# scripts). name:role:secret, comma-separated. Roles: ingest · viewer · analyst
# · service · admin. Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Humans do NOT sign in with these — see AUTH_* below.
BROKER_API_KEYS=ui-api:service:CHANGE_ME_SERVICE,siem:ingest:CHANGE_ME_INGEST,soclead:analyst:CHANGE_ME_ANALYST

# The same secret as the ui-api entry above. The UI API is a confidential
# client: it holds one service key and names the operator in X-Actor.
UI_API_BROKER_KEY=CHANGE_ME_SERVICE

# --- Human AAA (dashboard login) ------------------------------------------
# Operators sign in with username + argon2id password + ALTCHA captcha +
# email OTP. The UI API verifies RS256 access JWTs with the PUBLIC key only;
# the broker signs with the private key. Refresh cookie: AfraSOC_refresh
# (HttpOnly, SameSite=Strict, Path=/api/auth).
#
# Generate an RSA keypair once (PEM, unencrypted), then export the public half
# for the UI API. Compose mounts deploy/secrets/ read-only at /secrets:
#
#   mkdir -p deploy/secrets
#   openssl genrsa -out deploy/secrets/jwt-private.pem 2048
#   openssl rsa -in deploy/secrets/jwt-private.pem -pubout -out deploy/secrets/jwt-public.pem
#   # Broker runs as uid 10001 — mode 600 owned by your host user is unreadable
#   # inside the container and OTP returns 503. Use 644 on the bind-mounted PEMs.
#   chmod 644 deploy/secrets/jwt-private.pem deploy/secrets/jwt-public.pem
#
# Never mount the private PEM on the UI API. Paths below are inside the containers.
AUTH_JWT_PRIVATE_KEY_FILE=/secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_FILE=/secrets/jwt-public.pem
# HMAC for OTP and refresh-token hashes (not the JWT signing key).
AUTH_HMAC_KEY=CHANGE_ME_AUTH_HMAC_32_BYTES_MIN
# Secure cookie flag. false only for local HTTP; production must be true / omitted.
AUTH_COOKIE_SECURE=true

# First admin when operators is empty. Cleared from the process env after seed.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD_12PLUS
AUTH_BOOTSTRAP_EMAIL=soc-admin@example.com

# OTP delivery. Production default is smtp.
AUTH_OTP_DELIVERY=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=AfraSOC-noreply
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=AfraSOC-noreply@example.com
# Local-dev only (never production): log the OTP at WARNING instead of mailing.
# Requires AUTH_OTP_LOG_ENABLED=true exactly or the broker refuses to start.
# AUTH_OTP_DELIVERY=log
# AUTH_OTP_LOG_ENABLED=true

# Optional argon2id overrides (floors enforced: 64 MiB, time 3, parallelism 1).
# AUTH_ARGON2_MEMORY_KIB=65536
# AUTH_ARGON2_TIME_COST=3
# AUTH_ARGON2_PARALLELISM=1

# AfraSOC_API_KEYS is retired for human login. Do not set it — the dashboard
# uses JWT + OTP. Machine callers keep BROKER_API_KEYS above.

DASHBOARD_PORT=8080

# Frontend (Vite). Empty uses same-origin / Vite proxy; set for split deploys.
# VITE_API_BASE_URL=

# --- The model (Rule 5) ---------------------------------------------------
# 'echo' runs the entire layer with no model — correlation, cases, connectors,
# precedent and the dashboard all work. This is Stage 0.
LLM_PROVIDER=echo
# Stage 1: LLM_PROVIDER=ollama and name the GPU host. This is the host AI-SOC
# *dials* (it becomes OLLAMA_HOST inside the container). It is deliberately not
# called OLLAMA_HOST here: Ollama exports that name in your shell as a *bind*
# address (0.0.0.0:11434), and compose would prefer it to this file.
# AfraSOC_MODEL_HOST=gpu-host.internal
# AfraSOC_MODEL_PORT=11434
# MODEL_NAME=qwen2.5:7b
# MODEL_RUN_RETAIN_TEXT=true

# --- Verification (D1) ----------------------------------------------------
TI_PROVIDER=none
# TI_PROVIDER=local
# TI_LOCAL_FILE=reference/intel-indicators.json
# TI_PROVIDER=misp
# MISP_URL=https://misp.internal
# MISP_API_KEY=

# --- Autonomy (D4) --------------------------------------------------------
# Off. Turning it on still executes nothing until precedent says it may.
TIER2_AUTOPILOT=false
# Never false outside a lab: it reduces the gate to a confidence threshold.
TIER2_AUTOPILOT_REQUIRE_PRECEDENT=true

# --- What autopilot may never touch (F1, F2) ------------------------------
# Site files, read from AfraSOC_CONFIG_DIR (default deploy/config) and mounted
# read-only at /config. Write them BEFORE turning autopilot on:
#   cp orchestrator/config/assets.example.json     deploy/config/assets.json
#   cp orchestrator/config/identities.example.json deploy/config/identities.json
# Built-in name patterns catch domain controllers and obvious admin and service
# accounts; they know nothing about your estate. `preflight` says so.
# AfraSOC_CONFIG_DIR=./config
# ASSET_CRITICALITY_FILE=/config/assets.json
# IDENTITY_ROLES_FILE=/config/identities.json
# PROTECTED_TARGETS=

# --- Response connectors (E1) --------------------------------------------
# Start here. Every action is routed, validated and previewed, and nothing is
# sent. The pilot runbook says when to turn it off, and it is not on day one.
RESPONSE_DRY_RUN=true
RESPONSE_ROUTES=*=soar

# A real rollout looks like this — one class of action at a time:
# RESPONSE_ROUTES=block-ip=firewall,isolate=edr,disable-account=idp,*=soar
# CONNECTOR_FIREWALL_DRIVER=webhook
# CONNECTOR_FIREWALL_URL=https://fw-orchestrator.internal/api/block
# CONNECTOR_FIREWALL_TOKEN_ENV=FIREWALL_TOKEN
# CONNECTOR_FIREWALL_VERBS=block-ip,block-url
# FIREWALL_TOKEN=
#
# CONNECTOR_EDR_DRIVER=wazuh
# CONNECTOR_EDR_URL=https://wazuh.internal:55000
# CONNECTOR_EDR_USER=AfraSOC
# CONNECTOR_EDR_PASSWORD_ENV=WAZUH_PASSWORD
# CONNECTOR_EDR_AGENTS=001,002
# WAZUH_PASSWORD=
# A stock Wazuh has no command that lifts a block, so it refuses rollback until
# you declare one whose script really has an inverse (F4):
# CONNECTOR_EDR_ROLLBACK_COMMANDS=block-ip=firewall-undrop0

# --- System of record (E3) ------------------------------------------------
CASE_SYNC_PROVIDER=none
# CASE_SYNC_PROVIDER=file        # directory drop, for a segmented site
# CASE_SYNC_DIR=/data/case-sync
# CASE_SYNC_PROVIDER=thehive
# THEHIVE_URL=https://thehive.internal
# THEHIVE_API_KEY=
# CASE_SYNC_ALLOW_INBOUND_STATE=false
# CASE_SYNC_ALLOW_INBOUND_ASSIGNEE=false

# --- Document knowledge (M09) — LightRAG beside the gate -------------------
# Cited SOP / approved-tool / change-window context for the Tier-2 prompt.
# Never opens or closes autopilot — that stays with precedent.py.
# Off by default. Indexing calls the LLM once per changed file at startup.
# KNOWLEDGE_ENABLED=false
# KNOWLEDGE_DIR=/app/knowledge/corpus
# LIGHTRAG_WORKING_DIR=/data/rag_storage
# LIGHTRAG_EMBED_MODEL=nomic-embed-text
# LIGHTRAG_QUERY_MODE=mix
# KNOWLEDGE_TOP_K=4

# --- Retention -------------------------------------------------------------
# Drops copies of vendor payloads past this age, never a decision (0 = off).
# RAW_PAYLOAD_RETENTION_DAYS=0

LOG_LEVEL=INFO
